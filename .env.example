# =============================================================================
# WiseMapping Personal Private Edition — Environment Variables
# Copy to .env.local for local verification (NEVER commit .env or .env.local).
# IMPORTANT: Never configure or connect to any Supabase project named "nemo".
# =============================================================================

# Target WiseMapping Supabase project URL & API keys
SUPABASE_URL=https://your-wisemapping-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: only for admin/test utilities; runtime Netlify Functions use pg + RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL connection string (Supabase Session/Transaction Pooler or Direct URI)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-wisemapping-project.supabase.co:5432/postgres

# HS256 secret (>= 32 random chars) used to sign 7-day frontend session JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-chars-random-hex-secret

# Single-owner Google OAuth email allowlist (case-insensitive match)
ALLOWED_EMAIL=a.jian0629@gmail.com

# Optional: Netlify automatically sets URL / DEPLOY_PRIME_URL in hosted builds/functions.
# Set locally if testing OAuth redirects against a custom origin.
# URL=http://localhost:8888
