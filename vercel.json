{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && cd frontend && corepack enable && yarn install --immutable",
  "buildCommand": "cd frontend && corepack enable && yarn build",
  "outputDirectory": "frontend/packages/webapp/dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/restful/oauth2/:path*",
      "destination": "/api/wm-oauth?__wm_path=/api/restful/oauth2/:path*"
    },
    {
      "source": "/api/restful/:path*",
      "destination": "/api/wm-api?__wm_path=/api/restful/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "/api/wm-oauth?__wm_path=/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "/api/wm-oauth?__wm_path=/login/oauth2/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
